{
  "name": "mc-server-census",
  "version": "0.1.0",
  "private": true,
  "description": "Minecraft Server Census: continuously pings public Minecraft Java Edition servers, stores player counts/versions/metadata in SQLite and serves a public read-only dashboard.",
  "license": "MIT",
  "author": "Luca Azalim",
  "homepage": "https://census.azal.im",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucaazalim/minecraft-server-census.git"
  },
  "bugs": {
    "url": "https://github.com/lucaazalim/minecraft-server-census/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "start": "node --no-warnings=ExperimentalWarning dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json",
    "test": "node --import tsx --test test/*.test.ts",
    "ping": "tsx src/server/cli.ts ping",
    "sweep": "tsx src/server/cli.ts sweep",
    "discover": "tsx src/server/cli.ts discover",
    "probe": "tsx src/server/cli.ts probe",
    "regroup": "tsx src/server/cli.ts regroup",
    "groups": "tsx src/server/cli.ts groups",
    "prune": "tsx src/server/cli.ts prune",
    "blocklist": "tsx src/server/cli.ts blocklist",
    "add": "tsx src/server/cli.ts add",
    "remove": "tsx src/server/cli.ts remove",
    "compact": "tsx src/server/cli.ts compact",
    "thin": "tsx src/server/cli.ts thin",
    "suspects": "tsx src/server/cli.ts suspects",
    "country": "tsx src/server/cli.ts country"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
}
